{
  "name": "@cadence/engine",
  "version": "0.1.0",
  "description": "Human-realistic typing simulation: turn text into a deterministic, timed keystroke event stream for testing rich-text editors and recording demos.",
  "type": "module",
  "license": "MIT",
  "author": "the Cadence authors",
  "homepage": "https://github.com/Crispy252/TypeCloak/tree/main/packages/engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crispy252/TypeCloak.git",
    "directory": "packages/engine"
  },
  "bugs": "https://github.com/Crispy252/TypeCloak/issues",
  "keywords": [
    "typing",
    "keystroke",
    "human",
    "simulation",
    "testing",
    "playwright",
    "cypress",
    "rich-text",
    "editor",
    "deterministic"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "playground": "node -e \"const h=require('http'),f=require('fs'),p=require('path');h.createServer((q,s)=>{let u=q.url==='/'?'/playground/index.html':decodeURIComponent(q.url.split('?')[0]);let fp=p.join(process.cwd(),u);f.readFile(fp,(e,d)=>{if(e){s.writeCode=404;s.statusCode=404;return s.end('404');}const t=u.endsWith('.js')?'text/javascript':u.endsWith('.html')?'text/html':'text/plain';s.setHeader('content-type',t);s.end(d);});}).listen(4173,()=>console.log('Playground: http://localhost:4173/'));\""
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
